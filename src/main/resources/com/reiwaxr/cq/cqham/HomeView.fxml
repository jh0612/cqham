<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reiwaxr.cq.cqham.controller.HomeViewController">
   <children>
      <BorderPane>
         <top>
            <Label alignment="CENTER" disable="true" graphicTextGap="20.0" opacity="0.85" prefHeight="50.0" prefWidth="1100.0" style="-fx-background-color: red;" text="令和星人工具" textOverrun="CLIP" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </top>
         <center>
            <VBox alignment="TOP_CENTER" centerShape="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="20.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
               </padding>
               <children>
                  <Button fx:id="btnGoLog" mnemonicParsing="false" onAction="#btnGoLogClick" prefHeight="30.0" prefWidth="120.0" text="通联日志记录">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnGoFreq" mnemonicParsing="false" onAction="#btnGoFreqClick" prefHeight="30.0" prefWidth="120.0" text="频率查询工具">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnGoCall" mnemonicParsing="false" onAction="#btnGoCallClick" prefHeight="30.0" prefWidth="120.0" text="呼号查询">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
