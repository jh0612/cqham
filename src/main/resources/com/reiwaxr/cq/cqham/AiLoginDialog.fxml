<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="350.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reiwaxr.cq.cqham.controller.AiLoginDialogController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="15" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
            <children>
                <Label text="AI 智能助手 - 登录" style="-fx-text-fill: #2c3e50;">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>

                <Separator/>

                <VBox spacing="10">
                    <Label text="方式一：使用管理员账号（使用内置API Key）" style="-fx-text-fill: #27ae60;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" prefWidth="70"/>
                            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>
                        <Label text="账号:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfUsername" promptText="请输入账号" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="密码:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="pfPassword" promptText="请输入密码" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Button fx:id="btnLogin" text="管理员登录" onAction="#btnLoginClick" prefWidth="200" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                </VBox>

                <Separator/>

                <VBox spacing="10">
                    <Label text="方式二：直接使用API Key" style="-fx-text-fill: #2980b9;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <PasswordField fx:id="pfDirectApiKey" promptText="请输入你的API Key"/>
                    <Button fx:id="btnDirectLogin" text="使用API Key登录" onAction="#btnDirectLoginClick" prefWidth="200" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>