<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reiwaxr.cq.cqham.controller.LogViewController">
    <!-- 顶部表单区域 GridPane -->
    <top>
        <GridPane hgap="10.0" vgap="9.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <!-- 列约束：1、3列自动拉伸填充剩余空间 -->
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
            <ColumnConstraints minWidth="-Infinity" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints maxHeight="94.0" minHeight="5.0" prefHeight="20.0" />
                <RowConstraints maxHeight="92.0" minHeight="24.0" prefHeight="24.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="87.0" minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="77.0" minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="69.0" minHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="69.0" minHeight="29.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="71.0" minHeight="28.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="173.0" minHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <!-- 第0行 -->
            <Label disable="true" text="BI1WCB@Copyright" textFill="#bca9a9" GridPane.columnIndex="4" GridPane.rowIndex="1">
            <font>
               <Font name="Bell MT Italic" size="14.0" />
            </font></Label>
            <Label text="对方呼号:" GridPane.rowIndex="2" />
            <TextField fx:id="tfCallSign" maxWidth="-Infinity" minHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <!-- 第1行 -->
            <Label text="频率:" GridPane.rowIndex="3" />
            <Spinner fx:id="spfrequency" editable="true" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="QTH：" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="tfQth" maxWidth="-Infinity" minHeight="25.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <!-- 第2行 -->
            <Label text="对方设备:" GridPane.rowIndex="4" />
            <TextField fx:id="tfDevice" maxWidth="-Infinity" minHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="通联时间：" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <DatePicker fx:id="dpConnectDate" maxWidth="-Infinity" minHeight="25.0" GridPane.columnIndex="3" GridPane.rowIndex="4" />
            <!-- 第3行 -->
            <Label text="天气:" GridPane.rowIndex="5" />
            <ComboBox fx:id="cbWeather" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <Label text="功率：" GridPane.columnIndex="2" GridPane.rowIndex="5" />
            <ChoiceBox fx:id="cbpower" maxWidth="-Infinity" GridPane.columnIndex="3" GridPane.rowIndex="5" />
            <!-- 第4行 -->
            <Label text="信号报告：" GridPane.rowIndex="6" />
            <ChoiceBox fx:id="cbsignalReport" maxWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <Label text="QSL状态：" GridPane.columnIndex="2" GridPane.rowIndex="6" />
            <ChoiceBox fx:id="cbqslstatus" maxWidth="-Infinity" GridPane.columnIndex="3" GridPane.rowIndex="6" />
            <!-- 第5行 -->
            <Label text="姓名：" GridPane.rowIndex="7" />
            <TextField fx:id="tfname" maxWidth="-Infinity" minHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
            <Label text="住址：" GridPane.columnIndex="2" GridPane.rowIndex="7" />
            <TextField fx:id="tfAddress" maxWidth="-Infinity" minHeight="25.0" GridPane.columnIndex="3" GridPane.rowIndex="7" />
            <!-- 第6行 备注 -->
            <Label text="备注：" GridPane.rowIndex="8" />
            <TextArea fx:id="taRemark" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="32.0" prefHeight="94.0" prefWidth="821.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="8" />
            <!-- 通联模式单选框 放第1行第三列 -->
            <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="2">
                <RadioButton fx:id="radiobuttonFx" mnemonicParsing="false" onAction="#radiobuttonFx" selected="true" text="模拟FM">
                    <padding>
                        <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
                    </padding>
                    <HBox.margin>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                    </HBox.margin>
                    <toggleGroup>
                        <ToggleGroup fx:id="frequencyMode" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="radiobuttonYsf" mnemonicParsing="false" onAction="#radiobuttonysf" text="数字(YSF)" toggleGroup="$frequencyMode">
                    <padding>
                        <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
                    </padding>
                    <HBox.margin>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                    </HBox.margin>
                </RadioButton>
                <RadioButton fx:id="radiobuttonDmr" mnemonicParsing="false" onAction="#radiobuttondmr" text="数字(DMR)" toggleGroup="$frequencyMode">
                    <padding>
                        <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
                    </padding>
                    <HBox.margin>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                    </HBox.margin>
                </RadioButton>
            </HBox>
         <Label text="通联模式：" GridPane.columnIndex="2" GridPane.rowIndex="2" />
         <HBox disable="true" maxHeight="-Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />
        </GridPane>
    </top>

    <!-- 中间表格区域：自动填满剩余高度 -->
    <center>
        <TableView fx:id="tbLogList">
            <columns>
                <TableColumn fx:id="idCol" minWidth="53.0" text="ID" />
                <TableColumn fx:id="callSignCol" minWidth="75.0" text="呼号" />
                <TableColumn fx:id="timeCol" minWidth="81.0" text="通联日期" />
                <TableColumn fx:id="modeCol" minWidth="90.0" text="通联模式" />
                <TableColumn fx:id="frequencyCol" minWidth="76.0" text="频率" />
                <TableColumn fx:id="powerCol" minWidth="85.0" text="功率" />
                <TableColumn fx:id="qthCol" minWidth="75.0" text="QTH" />
                <TableColumn fx:id="deviceCol" minWidth="75.0" text="设备" />
                <TableColumn fx:id="weatherCol" minWidth="75.0" text="天气" />
                <TableColumn fx:id="signalReportCol" minWidth="75.0" text="信号报告" />
                <TableColumn fx:id="qslStatusCol" minWidth="75.0" text="QSL状态" />
                <TableColumn fx:id="nameCol" minWidth="75.0" text="姓名" visible="false" />
                <TableColumn fx:id="addressCol" minWidth="75.0" text="住址" visible="false" />
                <TableColumn fx:id="remarkCol" minWidth="174.0" text="备注" />
            </columns>
            <!-- 表格列自动均分剩余宽度 CONSTRAINED_RESIZE_POLICY-->
            <columnResizePolicy>
<!--                <TableView />-->
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- 底部按钮区域：居中，高度自适应 -->
    <bottom>
        <HBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#btnAddClick" text="新增日志" />
            <Button fx:id="btnSave" mnemonicParsing="false" text="保存" />
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#btnDeleteClick" text="删除选中" />
            <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearFormClick" text="清空表单" />
            <Button fx:id="btnBackMain" mnemonicParsing="false" onAction="#btnBackMainClick" text="返回主菜单" />
        </HBox>
    </bottom>
</BorderPane>
