<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reiwaxr.cq.cqham.controller.LogViewController">
   <children>
      <BorderPane prefHeight="700.0" prefWidth="1000.0">
         <top>
            <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="475.33331298828125" minWidth="10.0" prefWidth="95.33332061767577" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="864.6666793823242" minWidth="10.0" prefWidth="864.6666793823242" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label prefHeight="15.0" prefWidth="67.0" text="对方呼号:" />
                  <Label prefHeight="15.0" prefWidth="56.0" text="频率:" GridPane.rowIndex="1" />
                  <Label prefHeight="15.0" prefWidth="69.0" text="对方设备:" GridPane.rowIndex="3" />
                  <Label prefHeight="15.0" prefWidth="69.0" text="天气:" GridPane.rowIndex="4" />
                  <TextField fx:id="tfCallSign" GridPane.columnIndex="1" />
                  <TextField fx:id="tfFrequency" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="tfDevice" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <ComboBox fx:id="cbWeather" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label prefHeight="15.0" prefWidth="81.0" text="通联时间:" GridPane.rowIndex="5" />
                  <DatePicker fx:id="dpConnectDate" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <Label prefHeight="15.0" prefWidth="81.0" text="备注:" GridPane.rowIndex="6" />
                  <TextArea fx:id="taRemark" prefHeight="60.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  <Label text="QTH：" GridPane.rowIndex="2" />
                  <TextField fx:id="tfQth" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
         </top>
         <center>
            <TableView fx:id="tbLogList" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="idCol" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="callSignCol" prefWidth="75.0" text="呼号" />
                  <TableColumn fx:id="qthCol" prefWidth="75.0" text="QTH" />
                  <TableColumn fx:id="frequencyCol" prefWidth="75.0" text="频率" />
                  <TableColumn fx:id="timeCol" prefWidth="75.0" text="通联时间" />
                  <TableColumn fx:id="deviceCol" prefWidth="75.0" text="设备" />
                  <TableColumn fx:id="weatherCol" prefWidth="75.0" text="天气" />
              </columns>
            </TableView>
         </center>
         <bottom>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Button fx:id="btnAdd" mnemonicParsing="false" text="新增日志" />
                  <Button fx:id="btnSave" mnemonicParsing="false" text="保存" />
                  <Button fx:id="btnDelete" mnemonicParsing="false" text="删除选中" />
                  <Button fx:id="btnClear" mnemonicParsing="false" text="清空表单" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
