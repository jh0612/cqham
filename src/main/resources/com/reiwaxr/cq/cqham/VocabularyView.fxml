<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reiwaxr.cq.cqham.controller.VocabularyViewController" prefWidth="1100" prefHeight="750">
    <top>
        <VBox spacing="10">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Text text="标签筛选："/>
                <ComboBox fx:id="cbTagFilter" prefWidth="220"/>
                <Button text="查询" onAction="#btnSearch"/>
                <Button text="重置" onAction="#btnReset"/>
                <Button text="删除选中单词" onAction="#btnDelete"/>
                <Button text="返回首页" onAction="#btnBackMain"/>
            </HBox>
            <Label fx:id="lbCount" text="总数：0"/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tbVocabulary" prefHeight="600">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colSource" text="原文" prefWidth="260"/>
                <TableColumn fx:id="colTarget" text="译文" prefWidth="260"/>
                <TableColumn fx:id="colTag" text="标签" prefWidth="140"/>
                <TableColumn fx:id="colCreateTime" text="创建时间" prefWidth="200"/>
            </columns>
        </TableView>
    </center>
</BorderPane>