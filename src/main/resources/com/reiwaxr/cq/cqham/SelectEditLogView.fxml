<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reiwaxr.cq.cqham.controller.SelectEditLogViewController">
    <!-- 顶部：检索条件区域 -->
    <top>
        <VBox spacing="10">
            <Text text="多条件复合检索" />
            <!-- 第一行检索项 -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="呼号(精确)："/>
                <TextField fx:id="tfSearchCall" promptText="输入完整呼号，多个用英文逗号分隔"/>

                <Label text="通联日期范围："/>
                <DatePicker fx:id="dpStartDate"/>
                <Label text="~"/>
                <DatePicker fx:id="dpEndDate"/>
            </HBox>
            <!-- 第二行检索项 -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="天气："/>
                <ComboBox fx:id="cbSearchWeather" promptText="全部">
<!--                    <items>-->
<!--                        <String>晴</String>-->
<!--                        <String>多云</String>-->
<!--                        <String>阴</String>-->
<!--                        <String>雨</String>-->
<!--                        <String>雾</String>-->
<!--                        <String>大风</String>-->
<!--                    </items>-->
                </ComboBox>

                <Label text="频率："/>
                <TextField fx:id="tfSearchFreq" promptText="多个频率英文逗号分隔，最多200条"/>

                <Label text="通联模式："/>
                <ComboBox fx:id="cbSearchMode" promptText="全部">
                    <items>
<!--                        <String>FM</String>-->
<!--                        <String>YSF</String>-->
<!--                        <String>DMR</String>-->
                    </items>
                </ComboBox>

                <Label text="QSL状态："/>
                <ComboBox fx:id="cbSearchQsl" promptText="全部">
<!--                    <items>-->
<!--                        <String>已发送</String>-->
<!--                        <String>已接收</String>-->
<!--                        <String>未收发</String>-->
<!--                    </items>-->
                </ComboBox>
            </HBox>
            <!-- 按钮行 -->
            <HBox spacing="20">
                <Button fx:id="btnSearch" onAction="#btnSearchClick" text="执行检索"/>
                <Button fx:id="btnReset" onAction="#btnResetClick" text="重置条件"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnEditDb" onAction="#btnEditDbClick" text="编辑选中数据(更新数据库)"/>
                <Button fx:id="btnDeleteDb" onAction="#btnDeleteDbClick" text="删除选中数据库记录"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnBackMain" onAction="#backMain" text="返回主菜单" />
            </HBox>
        </VBox>
    </top>

    <!-- 中间：表格+分页 -->
    <center>
        <VBox spacing="8">
            <TableView fx:id="tbSearchResult" prefHeight="380">
                <columns>
                    <TableColumn text="ID" fx:id="idCol" prefWidth="60"/>
                    <TableColumn text="呼号" fx:id="callSignCol" prefWidth="90"/>
                    <TableColumn text="QTH" fx:id="qthCol" prefWidth="120"/>
                    <TableColumn text="频率" fx:id="frequencyCol" prefWidth="90"/>
                    <TableColumn text="模式" fx:id="modeCol" prefWidth="70"/>
                    <TableColumn text="通联日期" fx:id="dateCol" prefWidth="100"/>
                    <TableColumn text="时间" fx:id="timeCol" prefWidth="80"/>
                    <TableColumn text="设备" fx:id="deviceCol" minWidth="75.0" />
                    <TableColumn text="天气" fx:id="weatherCol" prefWidth="70"/>
                    <TableColumn text="信号报告" fx:id="signalReportCol" prefWidth="100"/>
                    <TableColumn text="功率" fx:id="powerCol" prefWidth="70"/>
                    <TableColumn text="QSL状态" fx:id="qslStatusCol" prefWidth="90"/>
                    <TableColumn text="姓名" fx:id="nameCol" minWidth="75.0" />
                    <TableColumn text="住址" fx:id="addressCol" minWidth="75.0" />
                    <TableColumn text="备注" fx:id="remarkCol" prefWidth="150"/>
                </columns>
            </TableView>
            <!-- 分页控件 -->
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="btnPrevPage" text="上一页"/>
                <Label fx:id="lbPageInfo" text="第1页 / 共0页"/>
                <Button fx:id="btnNextPage" text="下一页"/>
                <Label text="单页条数：20"/>
                <Label fx:id="lbTotalCount" text="总数据：0"/>
            </HBox>
        </VBox>
    </center>

    <!-- 底部：可视化预留区域 -->
    <bottom>
        <VBox spacing="5">
            <Text text="数据可视化区域(预留)"/>
            <BorderPane fx:id="visualPanel" prefHeight="220" style="-fx-border-color:#cccccc;-fx-border-width:1"/>
        </VBox>
    </bottom>
</BorderPane>
